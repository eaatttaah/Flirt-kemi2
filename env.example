# Quickpay (Danmark): Settings > Integration i Quickpay-administrationen
QUICKPAY_API_KEY=
QUICKPAY_PRIVATE_KEY=
# Offentlig https-adresse (til test: ngrok/cloudflared tunnel)
BASE_URL=https://din-adresse.example
PORT=3000
# Kodeord til admin-brugeren (brugernavn: admin). SKIFT DET. Flere operatører oprettes i /admin.html
ADMIN_PASSWORD=skift-mig-12345
